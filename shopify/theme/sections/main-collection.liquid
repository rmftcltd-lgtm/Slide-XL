<section class="band band--wash">
  <div class="shell">
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p class="lede">{{ collection.description }}</p>
    {% endif %}
    <div class="audience" style="margin-top:2rem">
      {% for product in collection.products %}
        <article>
          <a href="{{ product.url }}">
            {% if product.featured_image %}
              <img
                class="rounded"
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="800"
                height="600"
                loading="lazy"
              >
            {% endif %}
            <h2 style="margin-top:1rem">{{ product.title }}</h2>
            <p class="price" style="font-size:1.5rem">{{ product.price | money }}</p>
          </a>
        </article>
      {% else %}
        <p class="muted">No products in this collection yet.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
