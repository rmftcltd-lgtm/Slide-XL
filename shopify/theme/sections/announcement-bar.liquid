{% assign p = section.settings.product %}
{% if p == blank %}
  {% assign p = all_products['pre-launch-bundle'] %}
{% endif %}
{% if p != blank and p.compare_at_price > p.price %}
  {% assign save_amount = p.compare_at_price | minus: p.price | money_without_trailing_zeros %}
{% else %}
  {% assign save_amount = '$70' %}
{% endif %}

{% if section.settings.enable %}
  <div class="announce-bar" data-announce-bar>
    <a class="announce-bar__link" href="{{ section.settings.link | default: '#bundle' }}">
      <span class="announce-bar__text">
        {% if section.settings.text != blank %}
          {{ section.settings.text }}
        {% else %}
          🇺🇸 Pre-Launch Bundle — Save {{ save_amount }} + Free USA Shipping 🇺🇸
        {% endif %}
      </span>
    </a>
  </div>
{% endif %}

{% if section.settings.show_launcher %}
  <button
    class="deal-launcher"
    type="button"
    data-deal-launcher
    hidden
  >
    <span>{{ section.settings.launcher_label }}</span>
    <span class="deal-launcher__x" data-deal-launcher-dismiss aria-label="Dismiss">×</span>
  </button>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Show announcement bar", "default": true },
    { "type": "product", "id": "product", "label": "Bundle product (for savings)" },
    {
      "type": "text",
      "id": "text",
      "label": "Bar text (leave blank for auto savings copy)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Bar link"
    },
    {
      "type": "checkbox",
      "id": "show_launcher",
      "label": "Show floating Special Discount button",
      "default": true
    },
    {
      "type": "text",
      "id": "launcher_label",
      "label": "Floating button label",
      "default": "Special Discount"
    }
  ]
}
{% endschema %}
