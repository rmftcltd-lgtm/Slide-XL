<section class="password-page">
  <div class="password-page__bg" aria-hidden="true"></div>
  <div class="shell shell--narrow password-page__inner">
    <img
      class="password-page__logo"
      src="{{ 'slide-xl-logo.png' | asset_url }}"
      alt="Slide XL"
      width="96"
      height="96"
      loading="eager"
    >
    <p class="eyebrow eyebrow--purple">USA Pre-Launch</p>
    <h1>Slide <span>XL</span></h1>
    <p class="lede">{{ section.settings.message }}</p>

    {% form 'storefront_password', class: 'password-form' %}
      {% if form.errors != blank %}
        <div class="password-form__errors" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}
      <label class="visually-hidden" for="Password">Store password</label>
      <input
        id="Password"
        class="password-form__input"
        type="password"
        name="password"
        autocomplete="current-password"
        placeholder="{{ section.settings.placeholder }}"
        required
      >
      <button class="btn btn--primary" type="submit">{{ section.settings.button_label }}</button>
    {% endform %}

    <p class="password-page__hint muted">
      After unlock, open the
      <a href="/products/pre-launch-bundle">Pre-Launch Bundle</a>.
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "We're preparing the USA Pre-Launch Bundle. Enter the store password to preview."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter store password"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter store"
    }
  ]
}
{% endschema %}
