{
  "name": "slide-xl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "shopify:check": "shopify theme check --path shopify/theme",
    "shopify:dev": "shopify theme dev --path shopify/theme",
    "shopify:push": "shopify theme push --path shopify/theme --unpublished --theme \"Slide XL\"",
    "shopify:product": "node shopify/scripts/create-product.mjs",
    "shopify:deploy": "bash shopify/scripts/deploy.sh"
  },
  "dependencies": {
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@shopify/cli": "^4.5.2",
    "@shopify/theme": "^3.58.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
